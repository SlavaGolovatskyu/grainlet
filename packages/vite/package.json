  "scripts": {
    "test": "node test/transform.test.mjs"
  },
  "peerDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-syntax-jsx": "^7.23.0",
    "grainlet": "^1.0.0",
    "vite": ">=5.0.0"
  },
  "keywords": [
    "grainlet",
    "vite",
    "jsx",
    "babel",
    "signals",
    "typescript"
