{
  "name": "grainlet-vite",
  "version": "1.0.3",
  "description": "Vite plugin for Grainlet fine-grained JSX transforms",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wrap-jsx-accessors.babel.js",
    "jsx-templates.babel.js",
